# Drizzle
DATABASE_URL=local.db

# Comma-separated list of additional hosts allowed to serve this app,
# e.g. a domain behind a reverse proxy (host[:port], wildcards like "*.example.com" supported).
# "localhost:*" is always allowed and does not need to be listed here.
AUTH_ALLOWED_HOSTS=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Gestur
IMAGE_DIR="images"
DATA_DIR="data"
